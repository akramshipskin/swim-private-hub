// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  MEMBER
  // Pemilik kolam -- akses cuma ke wallet & pengajuan pencairan kolamnya
  // SENDIRI (lihat requireRole/proxy.ts), gak ada akses admin lintas-kolam.
  // Ditambah pas fitur wallet (2026-09-12); sebelumnya owner yang
  // dimigrasi diturunin ke MEMBER (gak ada UI apapun buat mereka) --
  // sekarang butuh role sendiri karena mereka perlu liat saldo & cairin.
  POOL_OWNER
}

enum WalletTransactionType {
  // Kredit ke Pool TEMPAT SESI BENERAN DIAJAR (Booking.availability.poolId),
  // bukan pool tempat Package dibeli -- paket sekarang lintas-kolam
  // (revisi 2026-09-12), jadi kredit ditunda sampai tau pasti kolam mana
  // yang beneran ngasih fasilitas buat sesi itu. Dicatat bareng
  // SESSION_PAYOUT (coach), share bookingId yang sama.
  SESSION_REVENUE
  // Kredit ke Coach buat 1 sesi yang ditandai Hadir.
  SESSION_PAYOUT
  // Saldo keluar pas WithdrawalRequest berhasil diproses.
  WITHDRAWAL
  // Komisi platform per sesi Hadir, sudah dipisah dari PPN-nya (poolId &
  // coachProfileId kosong = milik platform). Lihat splitPlatformTax.
  PLATFORM_REVENUE
  PLATFORM_TAX
  // Komisi afiliasi 5% ke coach ATAU kolam pemilik kode (tepat 1 terisi).
  // Dicatat bareng baris PLATFORM_REVENUE negatif senilai sama: komisi
  // dibayar dari bagian SPH (pajaknya ditanggung SPH). Lihat src/lib/affiliate.ts.
  AFFILIATE_COMMISSION
  // Potongan PPh 0,5% (PMK 37/2025, Hadi 2 Okt) dari bagian kolam/coach per
  // sesi paket model harga-dari-coach. Baris NEGATIF dengan poolId ATAU
  // coachProfileId (tepat 1 terisi): saldo mereka = kredit sesi - potongan.
  // Uangnya titipan pajak yang disetor SPH atas nama mereka, BUKAN pendapatan
  // SPH (tidak dihitung di PLATFORM_*). Lihat src/lib/pricing.ts.
  PPH_WITHHELD
}

// Penarikan saldo platform oleh admin (transfer manual dari akun Midtrans).
// Saldo platform = total ledger PLATFORM_* dikurangi baris di sini.
model PlatformWithdrawal {
  id            String   @id @default(cuid())
  revenueAmount Int
  taxAmount     Int
  note          String?
  // Bukti transfer (nomor referensi m-banking), wajib untuk penarikan baru
  // (keputusan Hadi 29 Sep). Kosong hanya untuk baris lama sebelum aturan ini.
  transferReference String?
  createdById   String
  createdAt     DateTime @default(now())
}

enum AttendanceReportStatus {
  OPEN
  RESOLVED
}

// Laporan member atas status "Tidak Hadir" yang menurutnya salah (keputusan
// Hadi 29 Sep): maksimal 3 hari setelah sesi selesai, 1 laporan per booking.
// Admin memeriksa, mengoreksi kehadiran lewat toggle biasa bila perlu, lalu
// menutup laporan dengan catatan.
model AttendanceReport {
  id           String                 @id @default(cuid())
  bookingId    String                 @unique
  booking      Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  memberId     String
  note         String?
  status       AttendanceReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@index([status, createdAt])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PackageStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  // Slot yang "dihapus" coach/admin padahal pernah dibooking (lalu batal):
  // disembunyikan dari semua daftar & tidak bisa dibooking, tapi barisnya
  // tetap ada supaya riwayat booking-nya tidak ikut terhapus (keputusan
  // Hadi 25 Sep). Slot tanpa riwayat tetap benar-benar dihapus.
  CLOSED
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum CancelledBy {
  MEMBER
  ADMIN
  COACH
}

enum MarkedBy {
  COACH
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  phone              String?  @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  // Saldo member (Hadi 2 Okt): selisih ganti ke coach lebih murah. Hanya untuk
  // membeli paket / tambah bayar, tidak bisa dicairkan. Cache dari
  // MemberWalletTransaction (sumber kebenaran).
  memberBalance      Int      @default(0)
  // Naik tiap password diganti/direset -- JWT yang nyimpen versi lama
  // ditolak di callback jwt (src/auth.ts), jadi sesi curian ikut mati.
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now())
  registeredReferer  String?
  registeredIp       String?
  // Bukti persetujuan S&K + Kebijakan Privasi saat daftar sendiri (versi =
  // tanggal dokumen, lihat src/lib/legal.ts). Null = akun dibuat admin/import.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  // Persetujuan perjanjian kemitraan lewat centang (coach: perjanjian coach,
  // pemilik kolam: MOU kolam). Lihat src/lib/partner-agreement.ts.
  partnerAgreementAcceptedAt DateTime?
  partnerAgreementVersion    String?
  // 2FA (TOTP, Google Authenticator) -- wajib untuk ADMIN. totpSecret terisi
  // saat setup dimulai; baru berlaku setelah totpEnabledAt terisi.
  // totpLastStep = langkah waktu kode terakhir yang dipakai (tolak kode ulang).
  totpSecret         String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  // Hapus akun (keputusan Hadi 25 Sep): member mengajukan, admin menyetujui.
  // Disetujui = data identitas dianonimkan (anonymizedAt), riwayat transaksi &
  // arsip chat tetap tersimpan tanpa identitas.
  deletionRequestedAt DateTime?
  anonymizedAt        DateTime?
  // Kapan admin menyetujui akun ini (tombol Aktifkan, atau admin yang membuat
  // akunnya). Null + nonaktif + COACH/POOL_OWNER = pendaftar mandiri yang
  // MENUNGGU persetujuan -- beda dari akun yang sengaja dinonaktifkan.
  approvedAt          DateTime?
  // Kode afiliasi yang diisi member saat mendaftar (opsional). Komisi dibayar
  // sekali per member -- lihat AffiliateCommission.
  referralCodeId      String?
  referralCode        AffiliateCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  affiliateCommission AffiliateCommission?

  coachProfile        CoachProfile?
  dependents          Dependent[]
  packages            Package[]
  bookings            Booking[]
  availabilities      Availability[]     @relation("CoachAvailabilities")
  coachedPackages     Package[]          @relation("PackageCoach")
  memberWalletTransactions MemberWalletTransaction[]
  coachChangeRequests      CoachChangeRequest[] @relation("CoachChangeMember")
  coachChangesFrom         CoachChangeRequest[] @relation("CoachChangeFrom")
  coachChangesTo           CoachChangeRequest[] @relation("CoachChangeTo")
  pushSubscriptions   PushSubscription[]
  poolAffiliations    PoolAffiliation[]  @relation("CoachPoolAffiliations")
  poolOwnerships      PoolOwnership[]    @relation("PoolOwners")
  chatThread          ChatThread?

  milestoneItemsCreated     MilestoneItem[]            @relation("MilestoneItemCreator")
  milestoneAchievements     MilestoneAchievement[]     @relation("MilestoneAchievementCoach")
  milestoneNotes            MilestoneNote[]            @relation("MilestoneNoteCoach")
  milestoneLevelCompletions MilestoneLevelCompletion[] @relation("MilestoneCompletionCoach")
}

// Chat bantuan (tombol mengambang) buat member/coach/pemilik kolam. 1 user =
// 1 thread. Dijawab AI kalau GEMINI_API_KEY / ANTHROPIC_API_KEY ada; pertanyaan yang AI gak
// yakin (atau AI belum aktif) ditandai needsAdmin dan muncul di tab Pesan admin.
model ChatThread {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  needsAdmin Boolean       @default(false)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]

  @@index([needsAdmin, updatedAt])
}

enum ChatSender {
  USER
  AI
  ADMIN
  SYSTEM
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    ChatSender
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

enum Gender {
  MALE
  FEMALE
}

enum CertificateStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model CoachProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  isActive Boolean @default(true)
  // Poin-poin keahlian (misal "Gaya bebas", "Anak usia dini", "Terapi
  // air") -- array pendek, ditampilin di halaman shortcut coach
  // (/pelatih/[id]) & profil. Bukan free-text panjang, biar konsisten
  // scan-able buat parent yang milih coach.
  specialties       String[] @default([])
  // Badge "plus poin" kalau coach punya sertifikasi renang resmi
  // (misal sertifikasi pelatih renang/lifeguard). certificationNote
  // opsional -- nama sertifikat/lembaga, ditampilin di sebelah badge.
  hasCertification  Boolean  @default(false)
  certificationNote String?
  // Foto profil (URL Supabase Storage). Sertifikat ada di tabel
  // CoachCertificate (kolom tunggal lama sudah dibuang 30 Sep).
  // hasCertification & certificationNote cuma "pengakuan" di form daftar
  // coach (belum diperiksa) -- dipakai sebagai isian awal nama sertifikat
  // di Profil.
  photoUrl          String?
  // Tanggal lahir & jenis kelamin coach -- orang tua sering memilih coach
  // berdasarkan dua hal ini. Umur dihitung dari birthDate (jangan simpan
  // umur sebagai angka: basi tiap tahun).
  birthDate         DateTime?
  gender            Gender?
  // Saldo coach ini dari bagian per-sesi (Pool.coachSharePercent),
  // dikredit pas booking ditandai Hadir. Lihat Pool.walletBalance buat
  // catatan yang sama soal cache-vs-ledger.
  walletBalance     Int      @default(0)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  // Harga jasa coach untuk paket 4 dan 8 sesi (Hadi 2 Okt), satu harga untuk
  // semua kolam, diubah coach sendiri dan langsung berlaku (paket yang sudah
  // dibeli menyimpan harganya sendiri di Package.coachPrice). null = belum
  // memasang harga, coach belum bisa dibeli.
  pricePack4        Int?
  pricePack8        Int?
  // Sudah menyerahkan surat pernyataan omzet < Rp500 juta/tahun: bagiannya
  // tidak dipotong PPh 0,5%. Hanya admin yang mengubah.
  pphExempt         Boolean  @default(false)

  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  certificates       CoachCertificate[]
  affiliateCode      AffiliateCode?
  affiliateCommissions AffiliateCommission[]
  // Gambar tanda tangan coach (path di bucket privat coach-certificates),
  // diunggah sekali, dipasang di sertifikat level milestone.
  signaturePath      String?
}

// Sertifikat coach (bisa banyak, Hadi 29 Sep). Tiap sertifikat diperiksa admin
// sendiri-sendiri; badge "Bersertifikat" tampil kalau >=1 berstatus APPROVED.
// Menggantikan kolom tunggal CoachProfile.certificateUrl/certificateStatus --
// isinya dipindah ke sini oleh migrasi coach_certificates.
model CoachCertificate {
  id             String            @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile      @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  // Nama sertifikat/lembaga, misal "Sertifikasi Pelatih Renang FASI".
  name           String
  // Path di bucket privat coach-certificates (dibuka lewat signed URL).
  // Wajib untuk unggahan baru; null hanya di baris lama hasil migrasi (akun
  // demo yang disetujui tanpa file).
  filePath       String?
  // NONE tidak dipakai di tabel ini (baris ada = sudah diunggah).
  status         CertificateStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([coachProfileId, status])
  @@index([status, createdAt])
}

// Ledger lengkap tiap pergerakan saldo -- walletBalance di Pool/CoachProfile
// itu CACHE (baca cepet), baris di sini yang jadi sumber kebenaran buat
// audit ("kenapa saldo gua segini"). Setiap update walletBalance WAJIB
// diiringi >=1 baris di sini dalam transaksi DB yang sama.
model WalletTransaction {
  id     String                @id @default(cuid())
  type   WalletTransactionType
  // Persis 1 dari dua ini yang keisi -- baris punya Pool ATAU CoachProfile,
  // gak pernah dua-duanya (dijaga CHECK "WalletTransaction_owner_matches_type"
  // di DB, lihat migrasi money_controls + validate_money_checks).
  poolId         String?
  pool           Pool?          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile?  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  // Positif = kredit (saldo nambah), negatif = debit (saldo berkurang).
  amount         Int
  // Referensi ke sumber transaksi -- paling banyak 1 yang keisi sesuai
  // type-nya (PACKAGE_SALE -> paymentId, SESSION_PAYOUT -> bookingId,
  // WITHDRAWAL -> withdrawalRequestId).
  paymentId          String?
  bookingId          String?
  withdrawalRequestId String?
  // Koreksi saldo oleh admin (baris SESSION_REVENUE/SESSION_PAYOUT tanpa
  // bookingId, plus pasangannya PLATFORM_REVENUE kalau dananya dari/ke
  // platform): alasan wajib + admin yang mencatat, ditampilkan ke coach/kolam
  // di halaman Saldo. Kosong untuk baris otomatis (sesi, pencairan) dan
  // koreksi lama yang dulu dicatat langsung di database.
  note           String?
  createdById    String?
  // Satu kiriman formulir koreksi = satu koreksi, walau terkirim dua kali.
  idempotencyKey String?  @unique
  createdAt      DateTime              @default(now())

  @@index([poolId])
  @@index([coachProfileId])
}

// Pengajuan pencairan saldo (kolam ATAU coach, sama pola exactly-1
// kayak WalletTransaction). Phase 1: PENDING dibuat sistem otomatis
// begitu user klik "Cairkan"; transisi ke PROCESSING/PAID/FAILED butuh
// Midtrans Iris (disbursement) terpasang -- sebelum itu ada, admin yang
// proses manual dari /admin/withdrawals (lihat src/lib/disbursement.ts).
model WithdrawalRequest {
  id     String           @id @default(cuid())
  poolId String?
  pool   Pool?            @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  amount Int
  status WithdrawalStatus @default(PENDING)
  // Disalin dari Pool/CoachProfile pas request dibuat -- kalau rekening
  // tujuan diedit belakangan, request yang UDAH ADA gak boleh ikut
  // berubah diam-diam (riwayat pencairan harus nunjukin kemana duitnya
  // BENERAN dikirim saat itu).
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  midtransReferenceId String?
  // Bukti transfer manual (nomor referensi dari m-banking), wajib saat admin
  // klik "Tandai Dibayar" -- keputusan Hadi 25 Sep.
  transferReference   String?
  // Admin yang menandai dibayar / menolak (jejak audit).
  processedById       String?
  failureReason       String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  @@index([poolId])
  @@index([coachProfileId])
}

// Profil anak nempel ke 1 akun ortu (User role MEMBER) -- 1 akun bisa
// punya banyak anak, tapi tetep 1 login/1 session buat semuanya. Bukan
// akun terpisah. isActive = soft delete: anak yang "dihapus" ortu cuma
// disembunyiin dari pilihan baru, riwayat Package/Booking lama tetap
// utuh (dibutuhin buat laporan honor coach).
model Dependent {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  // Peserta bisa akun itu sendiri (dewasa yang les sendiri), bukan cuma
  // anak -- isSelf nandain entry mana yang "diri sendiri" (nama-nya
  // dicopy dari User.name pas dibuat). Paling banyak 1 entry isSelf per
  // member, dicek di action layer (bukan constraint DB).
  isSelf    Boolean  @default(false)
  // Tanggal lahir peserta (anak atau dewasa), untuk level milestone per umur.
  // Wajib diisi saat menambah peserta baru; kosong untuk peserta lama.
  birthDate DateTime?
  // Kelompok milestone yang sedang dijalani. Diisi saat catatan milestone
  // pertama (dari umur, atau dipilih coach kalau tanggal lahir kosong). Tidak
  // ikut berganti otomatis saat umur naik di tengah level -- lihat
  // src/lib/milestone.ts (nextGroup).
  milestoneGroup MilestoneGroup?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  packages Package[]
  milestoneItems            MilestoneItem[]
  milestoneAchievements     MilestoneAchievement[]
  milestoneNotes            MilestoneNote[]
  milestoneLevelCompletions MilestoneLevelCompletion[]

  @@index([memberId])
}

// Katalog paket (harga/durasi) per KOLAM (locked /plan-eng-review
// 2026-09-12) -- tiap kolam pasang harga sendiri (kenyataan: kolam yang
// udah gabung sebelumnya emang udah punya harga masing-masing lewat
// Excel/WA, gak dipaksa 1 harga platform). poolId JUGA yang nentuin
// checkout Midtrans ini routing ke akun kolam mana (connector posture --
// platform gak pernah pegang dana, lihat Payment/Pool).
model PackageTemplate {
  id           String   @id @default(cuid())
  poolId       String
  pool         Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name         String
  totalSesi    Int
  price        Int
  // Masa berlaku paket dalam hari, dihitung dari startDate (aktivasi).
  durationDays Int      @default(60)
  // Jatah pembatalan mandiri (tanpa approval admin) yang dibawa tiap
  // paket yang dibuat dari template ini -- dicopy ke Package.jatahCancel
  // pas paket dibuat, BUKAN dibaca ulang dari template tiap kali cek
  // kuota (biar paket lama gak ikut berubah kalau template diedit).
  jatahCancel  Int      @default(2)
  // Paket trial (Hadi 29 Sep): 1 sesi, harga ditentukan SPH per kolam --
  // hanya admin yang membuat/mengubah. Hanya untuk peserta yang belum pernah
  // punya paket (1x per anak). Tidak ikut harga "mulai dari" & harga 1 sesi.
  isTrial      Boolean  @default(false)
  isActive     Boolean  @default(true)
  // Usulan perubahan dari pemilik kolam yang menunggu persetujuan admin
  // (lihat src/lib/package-template.ts). Nilai di atas = yang sedang dijual.
  pendingChanges Json?
  createdAt    DateTime @default(now())

  packages Package[]

  @@index([poolId])
}

model Package {
  id          String           @id @default(cuid())
  memberId    String
  member      User             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Wajib -- 1 paket = 1 anak, gak pooled/gak bisa dipake gantian antar
  // anak. Ditulis sekali pas paket dibuat; kalau paket ini udah punya
  // >=1 Booking, dependentId GAK BOLEH diedit lagi (dicek di action
  // layer, bukan constraint DB) -- soalnya Booking gak nyimpen anak
  // sendiri, "anak"-nya booking diturunin dari sini. Edit dependentId
  // setelah ada booking = nge-rewrite riwayat anak booking lama diam-diam.
  dependentId String
  dependent   Dependent        @relation(fields: [dependentId], references: [id])
  // Kolam tempat beli, DAN satu-satunya kolam tempat paket ini bisa
  // dibooking (revisi 2026-09-17, gantiin paket lintas-kolam 2026-09-12:
  // beli di kolam murah lalu dipake di kolam mahal bikin kolam mahal
  // dibayar pake harga kolam murah). Mau renang di kolam lain = beli
  // paket 1 sesi di kolam itu (isSingleSession), lihat src/lib/drop-in.ts.
  poolId      String
  pool        Pool             @relation(fields: [poolId], references: [id])
  templateId  String?
  template    PackageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  totalSesi   Int
  sisaSesi    Int
  // Dicopy dari PackageTemplate.jatahCancel pas paket dibuat (atau
  // diisi manual kalau paket custom/assign langsung). Ini yang dipakai
  // buat cek kuota self-cancel, bukan konstanta global -- tiap paket
  // bisa punya jatah beda.
  jatahCancel Int              @default(2)
  // Model harga-dari-coach (Hadi 2 Okt): paket terikat ke 1 coach. Harga
  // kolam, harga coach, dan biaya layanan SPH disalin saat dibeli -- dasar
  // pembagian uang tiap sesi (src/lib/pricing.ts), tidak ikut berubah kalau
  // harga diubah belakangan. Semua null = paket model lama (katalog kolam,
  // bagi hasil persen kolam, boleh coach mana pun di kolam itu).
  coachId      String?
  coach        User?           @relation("PackageCoach", fields: [coachId], references: [id])
  poolPrice    Int?
  coachPrice   Int?
  serviceFee   Int?
  // Masa berlaku (hari) sejak aktif; null = ikut template/aturan lama.
  durationDays Int?
  // Bagian harga yang dibayar dari saldo member (sisanya lewat Midtrans,
  // Payment.amount). Total harga paket model baru = poolPrice + coachPrice + serviceFee.
  saldoUsed    Int              @default(0)
  coachChangeRequests CoachChangeRequest[]
  // Paket eceran 1 sesi buat renang di kolam selain kolam paket utama.
  // Cuma bisa dibeli member yang masih punya paket biasa (bukan 1 sesi)
  // yang aktif -- dan paket 1 sesi sendiri gak ngitung sebagai syarat itu.
  isSingleSession Boolean      @default(false)
  // Disalin dari PackageTemplate.isTrial saat dibeli.
  isTrial     Boolean          @default(false)
  status      PackageStatus    @default(PENDING_PAYMENT)
  startDate   DateTime?
  expiredDate DateTime?
  createdAt   DateTime         @default(now())

  payments Payment[]
  bookings Booking[]

  @@index([memberId])
  @@index([dependentId])
  @@index([poolId])
  @@index([coachId])
}

model Payment {
  id                String        @id @default(cuid())
  packageId         String
  package           Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  midtransOrderId   String        @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload Json?
  // Waktu pembayaran jadi SUCCESS (diisi webhook). Dasar laporan "uang masuk"
  // -- bukan createdAt (waktu checkout) atau updatedAt (berubah tiap
  // notifikasi duplikat dari Midtrans).
  paidAt            DateTime?
  // Link halaman bayar Midtrans (berlaku ~24 jam) -- tombol "Lanjut bayar"
  // untuk paket yang masih menunggu pembayaran.
  snapRedirectUrl   String?
  // Diisi kalau pembayaran ini tambahan bayar ganti coach (bukan pembelian
  // paket): webhook menyelesaikan pengajuannya, status paket tidak disentuh.
  coachChangeRequestId String?
  coachChangeRequest   CoachChangeRequest? @relation(fields: [coachChangeRequestId], references: [id])
  // Cookie Pixel Meta (_fbp/_fbc) + user agent saat checkout, untuk event
  // Purchase dari server saat notifikasi lunas (src/lib/meta-capi.ts). Tanpa IP.
  // Dikosongkan saat akun member dihapus (anonim).
  metaTracking      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([packageId])
  @@index([status, paidAt])
}

model Availability {
  id             String             @id @default(cuid())
  coachId        String
  coach          User               @relation("CoachAvailabilities", fields: [coachId], references: [id], onDelete: Cascade)
  // Kolam tempat slot ini dibuka. Coach independen dari Pool manapun
  // (PoolAffiliation), tapi tiap slot yang dibuka tetep pin ke SATU
  // kolam spesifik -- coach gak bisa "buka slot generik" tanpa kolam.
  poolId         String
  pool           Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  startTime      DateTime
  endTime        DateTime
  kapasitas      Int                @default(1)
  status         AvailabilityStatus @default(AVAILABLE)
  // Kosong buat MVP (availability per hari, input manual). Kolom ini
  // yang dipakai kalau fitur recurring/per-minggu ditambah belakangan,
  // biar gak perlu migrasi skema ulang.
  recurrenceRule String?
  createdAt      DateTime           @default(now())

  bookings Booking[]

  // SENGAJA gak ada poolId di constraint ini -- 1 coach cuma boleh
  // punya 1 slot terbuka per (date, startTime) di SELURUH kolam, titik.
  // Coach gak bisa ada di 2 tempat jam yang sama. Constraint dgn poolId
  // di dalamnya cuma nyegah duplikat slot yang SAMA di kolam yang SAMA,
  // gak nyegah coach ke-double-book lintas kolam -- itu bug yang
  // ketemu pas /plan-eng-review 2026-09-12.
  @@unique([coachId, date, startTime])
  @@index([poolId, date])
}

// Kolam/venue -- 1 pool = 1 lokasi fisik. SERVICE PROVIDER posture
// (revisi 2026-09-12, gantiin connector): platform pegang 1 akun
// Midtrans sendiri (QRIS), SEMUA transaksi dari SEMUA kolam masuk ke
// situ dulu -- makanya gak ada lagi kredensial Midtrans per-pool di
// sini (lihat src/lib/midtrans.ts, balik ke 1 akun global kayak
// les-renang-cianjur). Bagian kolam & coach disimpen di wallet
// (walletBalance) abis komisi platform kepotong, dicairkan manual
// lewat WithdrawalRequest.
model Pool {
  id                 String   @id @default(cuid())
  name               String
  address            String?
  contactPhone       String?
  // Jam operasional harian (format "HH:mm", misal "06:00"/"21:00").
  // Satu jam buka-tutup buat semua hari -- MVP, belum per-hari (Senin
  // beda jam sama Minggu dst). Ditampilin di profil kolam, BUKAN
  // constraint yang nge-block coach buka slot di luar jam ini (belum
  // divalidasi di action layer, murni informasional buat sekarang).
  openTime           String?
  closeTime          String?
  // Deskripsi & fasilitas kolam (warung, mushola, toilet, dst) -- diisi
  // pemilik kolam atau admin, tampil di landing, booking, halaman coach.
  description        String?
  facilities         String[] @default([])
  // Foto fasilitas kolam (URL publik Supabase Storage), diunggah pemilik
  // kolam/admin. Urutan array = urutan tampil; foto pertama jadi sampul.
  photos             String[] @default([])
  // Persentase komisi platform, di-set platform (bukan per-coach). Bawaan
  // kolam baru 10% (keputusan Hadi 29-30 Sep: contoh sesi Rp100.000 = kolam
  // 50.000, coach 40.000, SPH 10.000); disetel per kolam di Admin > Bagi Hasil.
  commissionPercent  Int      @default(10)
  // Persentase dari HARGA PAKET (bukan dari sisa abis komisi) yang jadi
  // bagian coach per sesi -- dikredit ke walletBalance coach BARENGAN
  // sama walletBalance kolam sendiri dikredit, pas booking ditandai
  // Hadir (lihat src/lib/wallet.ts). commissionPercent + coachSharePercent
  // harus <=100 (sisanya buat kolam), dicek di action layer pas admin edit.
  coachSharePercent  Int      @default(40)
  // Model harga-dari-coach (Hadi 2 Okt): harga tiket kolam untuk paket 4 dan
  // 8 sesi (1 coach + 1 peserta + 1 pendamping per sesi), diubah pemilik
  // kolam/admin dan langsung berlaku. null = kolam belum memasang harga.
  pricePack4         Int?
  pricePack8         Int?
  // Biaya layanan SPH di atas harga kolam + coach, dalam basis poin
  // (650 = 6,5%). Dibatasi maks 690 (bahasa ke pengguna: "di bawah 7%").
  serviceFeeBps      Int      @default(650)
  // Lihat CoachProfile.pphExempt.
  pphExempt          Boolean  @default(false)
  // Saldo kolam ini dari sesi-sesi yang BENERAN diajar di kolam ini
  // (dikredit pas Booking ditandai Hadir, bukan pas Package dibeli --
  // revisi 2026-09-12: paket lintas-kolam, kolam yang kredit itu kolam
  // TEMPAT SESI, bukan kolam tempat paket dibeli). Cache, lihat
  // WalletTransaction buat sumber kebenaran.
  walletBalance      Int      @default(0)
  // Tujuan pencairan (WithdrawalRequest). Nullable -- kolam yang belum
  // isi ini gak bisa ajuin cairin (dicek di action layer).
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  affiliations       PoolAffiliation[]
  availabilities     Availability[]
  packageTemplates   PackageTemplate[]
  packages           Package[]
  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  ownerships         PoolOwnership[]
  affiliateCode      AffiliateCode?
  affiliateCommissions AffiliateCommission[]
}

// Many-to-many User(role=POOL_OWNER) <-> Pool -- gantiin Pool.ownerUserId
// (1 kolam = 1 owner doang) yang gak ngedukung 1 orang punya beberapa
// kolam sekaligus. Sama pola persis kayak PoolAffiliation (coach <-> pool),
// cuma beda arah relasi (owner, bukan orang yang ngajar).
model PoolOwnership {
  id        String   @id @default(cuid())
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation("PoolOwners", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([poolId, ownerId])
  @@index([ownerId])
}

// Many-to-many Coach <-> Pool. Coach (User role=COACH) tetep entity
// independen -- baris ini cuma nyatet "coach X bisa buka slot di kolam
// Y", bukan kepemilikan.
model PoolAffiliation {
  id        String   @id @default(cuid())
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachPoolAffiliations", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([poolId, coachId])
  @@index([coachId])
}

// Testimoni asli yang tampil di landing ("Kata mereka"). Diisi/diubah admin di
// /admin/testimoni; bagian landing tersembunyi kalau tidak ada yang tampil.
// consentNote wajib: bukti izin yang bersangkutan (siapa, kapan, lewat apa).
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  quote       String
  consentNote String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isPublished, sortOrder])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id             String        @id @default(cuid())
  memberId       String
  member         User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  availabilityId String
  availability   Availability  @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  // "Anak" buat booking ini diturunin transitif lewat packageId ->
  // Package.dependentId -- sengaja gak nyimpen field anak sendiri di
  // sini, biar cuma ada 1 sumber kebenaran (bukan 2 field yang bisa
  // nyimpang). Relasi Package ditambah sekalian (sebelumnya packageId
  // cuma string lepas, gak ada FK constraint di DB sama sekali).
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  status         BookingStatus @default(BOOKED)
  cancelledBy    CancelledBy?
  cancelledAt    DateTime?
  // null = belum ditandai, true = member hadir (sesi valid buat coach),
  // false = member gak hadir (gak dihitung ke sesi valid coach walau
  // booking-nya tetep BOOKED dan sesi member tetep kepotong).
  attended       Boolean?
  attendedBy     MarkedBy?
  attendedAt     DateTime?
  attendanceReport AttendanceReport?
  createdAt      DateTime      @default(now())

  @@index([memberId])
  @@index([availabilityId])
  @@index([packageId])
}

// Inbox email eksternal (hello@swimprivatehub.biz.id, via Resend Inbound) --
// beda dari ChatThread (itu chat bantuan in-app member/coach/pool <-> admin).
// 1 alamat email eksternal = 1 thread, sama kayak pola ChatThread per user.
model EmailThread {
  id            String         @id @default(cuid())
  externalEmail String         @unique
  subject       String
  needsAdmin    Boolean        @default(true)
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  messages      EmailMessage[]

  @@index([needsAdmin, updatedAt])
  // Indeks lama dari migrasi 20260923001318 (dobel dengan @unique, tapi ada di
  // semua database). Dicatat di sini supaya migrasi baru tidak terus membuat
  // DROP INDEX; dibuang kalau suatu saat ada migrasi yang sengaja menghapusnya.
  @@index([externalEmail])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      EmailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction   EmailDirection
  fromAddress String
  toAddress   String
  subject     String
  textBody    String
  htmlBody    String?
  // id dari Resend (email_id pas INBOUND, id hasil send pas OUTBOUND) --
  // dipakai buat header In-Reply-To/References biar thread nyambung di
  // client email eksternal, dan cegah dobel-simpan webhook retry.
  resendId    String?        @unique
  createdAt   DateTime       @default(now())

  @@index([threadId, createdAt])
}

// Catatan percobaan untuk pembatasan (login salah, pendaftaran) -- lihat
// src/lib/rate-limit.ts. Satu baris = satu percobaan yang dihitung.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Milestone perkembangan peserta (Hadi 29 Sep). Catatan melekat ke PESERTA
// (Dependent), bukan ke coach: coach baru melanjutkan dari butir berikutnya.
// Daftar butir standar: docs/designs/milestone-daftar-keterampilan-draf.md,
// diisi oleh migrasi milestone. Logika level/kelompok: src/lib/milestone.ts.

// A = 6 bln-3 th (bersama orang tua), B = 4-6, C = 7-12, D = 13+.
enum MilestoneGroup {
  A
  B
  C
  D
}

enum MilestoneProposalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model MilestoneItem {
  id          String                  @id @default(cuid())
  group       MilestoneGroup
  level       Int
  sortOrder   Int                     @default(0)
  text        String
  // null = butir standar SPH (berlaku untuk semua peserta di kelompok itu).
  // Terisi = butir tambahan coach khusus peserta ini. Usulan yang disetujui
  // admin dijadikan standar dengan mengosongkan kolom ini.
  dependentId String?
  dependent   Dependent?              @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?                   @relation("MilestoneItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  proposalStatus MilestoneProposalStatus @default(NONE)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())

  achievements MilestoneAchievement[]
  focusNotes   MilestoneNote[]

  @@index([group, level])
  @@index([dependentId])
  @@index([proposalStatus])
}

// Butir yang sudah tercapai peserta. priorSkill = dicentang saat penilaian
// awal ("sudah bisa sebelumnya"), tidak dihitung untuk sertifikat.
model MilestoneAchievement {
  id          String        @id @default(cuid())
  dependentId String
  dependent   Dependent     @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  itemId      String
  item        MilestoneItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  coachId     String?
  coach       User?         @relation("MilestoneAchievementCoach", fields: [coachId], references: [id], onDelete: SetNull)
  priorSkill  Boolean       @default(false)
  achievedAt  DateTime      @default(now())

  @@unique([dependentId, itemId])
}

// Satu kali "Update milestone" oleh coach. Inilah yang dihitung untuk
// penahanan pencairan coach (lihat src/lib/milestone-hold.ts): tiap peserta
// wajib dapat catatan dari coach-nya minimal sekali tiap 2 sesi Hadir.
model MilestoneNote {
  id          String         @id @default(cuid())
  dependentId String
  dependent   Dependent      @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  coachId     String
  coach       User           @relation("MilestoneNoteCoach", fields: [coachId], references: [id], onDelete: Cascade)
  // Butir yang sedang dilatih (opsional).
  focusItemId String?
  focusItem   MilestoneItem? @relation(fields: [focusItemId], references: [id], onDelete: SetNull)
  note        String
  createdAt   DateTime       @default(now())

  @@index([coachId, dependentId, createdAt])
  @@index([dependentId, createdAt])
}

// Level yang sudah selesai. Dicatat sekali saat butir terakhirnya tercapai;
// butir standar yang ditambah belakangan tidak membuka ulang level ini.
// withCertificate = false kalau seluruh butirnya dari penilaian awal.
model MilestoneLevelCompletion {
  id              String         @id @default(cuid())
  dependentId     String
  dependent       Dependent      @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  group           MilestoneGroup
  level           Int
  coachId         String?
  coach           User?          @relation("MilestoneCompletionCoach", fields: [coachId], references: [id], onDelete: SetNull)
  withCertificate Boolean
  completedAt     DateTime       @default(now())

  @@unique([dependentId, group, level])
}

// ---------------------------------------------------------------------------
// Afiliasi (Hadi 29 Sep): kode singkat per coach dan per kolam, diisi member
// di form daftar. Komisi 5% dari pembayaran paket pertama member, sekali per
// member, cair ke saldo pemilik kode 3 hari setelah sesi pertama Hadir.

model AffiliateCode {
  id             String        @id @default(cuid())
  // Huruf besar + angka, unik (misal NADIA7).
  code           String        @unique
  // Tepat 1 terisi (CHECK AffiliateCode_exactly_one_owner).
  coachProfileId String?       @unique
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  poolId         String?       @unique
  pool           Pool?         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  referredUsers User[]
}

enum AffiliateCommissionStatus {
  // Sesi Hadir yang memenuhi syarat belum ada / dibatalkan koreksi.
  WAITING
  // Menunggu masa tahan (releaseAt).
  PENDING
  // Sudah masuk saldo pemilik kode (tidak ditarik balik).
  RELEASED
}

model AffiliateCommission {
  id             String                    @id @default(cuid())
  // Sekali per member.
  memberId       String                    @unique
  member         User                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile?             @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  poolId         String?
  pool           Pool?                     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  // Pembayaran paket pertama member (dasar 5%).
  paymentId      String
  amount         Int
  status         AffiliateCommissionStatus @default(WAITING)
  // Sesi Hadir yang memicu hitungan 3 hari (null saat WAITING).
  bookingId      String?
  releaseAt      DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                  @default(now())

  @@index([status, releaseAt])
  @@index([coachProfileId])
  @@index([poolId])
}

// Buku besar saldo member (Hadi 2 Okt). amount positif = masuk, negatif = terpakai.
enum MemberWalletType {
  // Selisih ganti ke coach lebih murah (atau kelebihan tambah bayar).
  COACH_CHANGE_CREDIT
  // Dipakai membeli paket / tambah bayar ganti coach (negatif).
  PURCHASE
  // Pengembalian saldo saat pembayaran gagal/kedaluwarsa (positif).
  PURCHASE_REFUND
}

model MemberWalletTransaction {
  id                   String           @id @default(cuid())
  memberId             String
  member               User             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type                 MemberWalletType
  amount               Int
  // Tanpa relasi: paket yang batal dibuat (Midtrans gagal) dihapus, catatan tetap ada.
  packageId            String?
  coachChangeRequestId String?
  note                 String?
  createdAt            DateTime         @default(now())

  @@index([memberId, createdAt])
  @@index([packageId])
}

// Pengajuan ganti coach (Hadi 2 Okt): member mengajukan dengan alasan, admin
// memutuskan (coach lama diberi tahu). Hanya ke coach lain di kolam yang sama.
// amount = selisih sisa sesi dengan harga coach baru (positif = member tambah
// bayar, negatif = masuk saldo member), dihitung saat disetujui.
enum CoachChangeStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

model CoachChangeRequest {
  id          String            @id @default(cuid())
  packageId   String
  package     Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  memberId    String
  member      User              @relation("CoachChangeMember", fields: [memberId], references: [id], onDelete: Cascade)
  fromCoachId String
  fromCoach   User              @relation("CoachChangeFrom", fields: [fromCoachId], references: [id])
  toCoachId   String
  toCoach     User              @relation("CoachChangeTo", fields: [toCoachId], references: [id])
  reason      String
  status      CoachChangeStatus @default(PENDING)
  sessions    Int?
  amount      Int?
  // Harga paket coach baru (ukuran paket ini) saat disetujui -- dipakai saat
  // menyelesaikan, supaya perubahan harga coach di tengah jalan tidak mengubah
  // tagihan yang sudah dibayar.
  newCoachPrice Int?
  // Harga coach lama & biaya layanan paket sebelum pindah (diisi saat selesai):
  // sesi yang dijalani coach lama tetap dibagi dengan harga ini, termasuk kalau
  // tanda hadirnya diubah setelah pindah coach.
  oldCoachPrice Int?
  oldServiceFee Int?
  // Bagian tambah bayar yang diambil dari saldo member.
  saldoUsed   Int               @default(0)
  adminNote   String?
  decidedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  payments Payment[]

  @@index([status, createdAt])
  @@index([packageId])
}

// Setoran titipan PPh 0,5% ke kantor pajak (dicatat admin). Titipan belum
// disetor = -SUM(WalletTransaction PPH_WITHHELD) - SUM(amount di sini).
model PphRemittance {
  id          String   @id @default(cuid())
  amount      Int
  reference   String
  note        String?
  createdById String
  createdAt   DateTime @default(now())
}
