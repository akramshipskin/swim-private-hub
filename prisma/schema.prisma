// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  MEMBER
}

enum PackageStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum CancelledBy {
  MEMBER
  ADMIN
}

enum MarkedBy {
  COACH
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  phone              String?  @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  coachProfile      CoachProfile?
  dependents        Dependent[]
  packages          Package[]
  bookings          Booking[]
  availabilities    Availability[]     @relation("CoachAvailabilities")
  pushSubscriptions PushSubscription[]
}

model CoachProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  isActive Boolean @default(true)
}

// Profil anak nempel ke 1 akun ortu (User role MEMBER) -- 1 akun bisa
// punya banyak anak, tapi tetep 1 login/1 session buat semuanya. Bukan
// akun terpisah. isActive = soft delete: anak yang "dihapus" ortu cuma
// disembunyiin dari pilihan baru, riwayat Package/Booking lama tetap
// utuh (dibutuhin buat laporan honor coach).
model Dependent {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  // Peserta bisa akun itu sendiri (dewasa yang les sendiri), bukan cuma
  // anak -- isSelf nandain entry mana yang "diri sendiri" (nama-nya
  // dicopy dari User.name pas dibuat). Paling banyak 1 entry isSelf per
  // member, dicek di action layer (bukan constraint DB).
  isSelf    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  packages Package[]

  @@index([memberId])
}

// Katalog paket (harga/durasi) yang admin kelola, gak nempel ke member
// manapun. Ini yang dipilih member pas checkout Midtrans, atau jadi
// starting point admin pas assign paket manual ke member.
model PackageTemplate {
  id           String   @id @default(cuid())
  name         String
  totalSesi    Int
  price        Int
  // Masa berlaku paket dalam hari, dihitung dari startDate (aktivasi).
  durationDays Int      @default(60)
  // Jatah pembatalan mandiri (tanpa approval admin) yang dibawa tiap
  // paket yang dibuat dari template ini -- dicopy ke Package.jatahCancel
  // pas paket dibuat, BUKAN dibaca ulang dari template tiap kali cek
  // kuota (biar paket lama gak ikut berubah kalau template diedit).
  jatahCancel  Int      @default(2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  packages Package[]
}

model Package {
  id          String           @id @default(cuid())
  memberId    String
  member      User             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Wajib -- 1 paket = 1 anak, gak pooled/gak bisa dipake gantian antar
  // anak. Ditulis sekali pas paket dibuat; kalau paket ini udah punya
  // >=1 Booking, dependentId GAK BOLEH diedit lagi (dicek di action
  // layer, bukan constraint DB) -- soalnya Booking gak nyimpen anak
  // sendiri, "anak"-nya booking diturunin dari sini. Edit dependentId
  // setelah ada booking = nge-rewrite riwayat anak booking lama diam-diam.
  dependentId String
  dependent   Dependent        @relation(fields: [dependentId], references: [id])
  templateId  String?
  template    PackageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  totalSesi   Int
  sisaSesi    Int
  // Dicopy dari PackageTemplate.jatahCancel pas paket dibuat (atau
  // diisi manual kalau paket custom/assign langsung). Ini yang dipakai
  // buat cek kuota self-cancel, bukan konstanta global -- tiap paket
  // bisa punya jatah beda.
  jatahCancel Int              @default(2)
  status      PackageStatus    @default(PENDING_PAYMENT)
  startDate   DateTime?
  expiredDate DateTime?
  createdAt   DateTime         @default(now())

  payments Payment[]
  bookings Booking[]

  @@index([memberId])
  @@index([dependentId])
}

model Payment {
  id                String        @id @default(cuid())
  packageId         String
  package           Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  midtransOrderId   String        @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([packageId])
}

model Availability {
  id             String             @id @default(cuid())
  coachId        String
  coach          User               @relation("CoachAvailabilities", fields: [coachId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  startTime      DateTime
  endTime        DateTime
  kapasitas      Int                @default(1)
  status         AvailabilityStatus @default(AVAILABLE)
  // Kosong buat MVP (availability per hari, input manual). Kolom ini
  // yang dipakai kalau fitur recurring/per-minggu ditambah belakangan,
  // biar gak perlu migrasi skema ulang.
  recurrenceRule String?
  createdAt      DateTime           @default(now())

  bookings Booking[]

  @@unique([coachId, date, startTime])
  @@index([coachId, date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id             String        @id @default(cuid())
  memberId       String
  member         User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  availabilityId String
  availability   Availability  @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  // "Anak" buat booking ini diturunin transitif lewat packageId ->
  // Package.dependentId -- sengaja gak nyimpen field anak sendiri di
  // sini, biar cuma ada 1 sumber kebenaran (bukan 2 field yang bisa
  // nyimpang). Relasi Package ditambah sekalian (sebelumnya packageId
  // cuma string lepas, gak ada FK constraint di DB sama sekali).
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  status         BookingStatus @default(BOOKED)
  cancelledBy    CancelledBy?
  cancelledAt    DateTime?
  // null = belum ditandai, true = member hadir (sesi valid buat coach),
  // false = member gak hadir (gak dihitung ke sesi valid coach walau
  // booking-nya tetep BOOKED dan sesi member tetep kepotong).
  attended       Boolean?
  attendedBy     MarkedBy?
  attendedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([memberId])
  @@index([availabilityId])
  @@index([packageId])
}
