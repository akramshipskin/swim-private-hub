# PostgreSQL connection string (Supabase). Untuk migrasi, pakai session
# pooler (port 5432) -- transaction pooler (port 6543) tidak support
# advisory lock yang dibutuhkan `prisma migrate`.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=no-verify"

# NextAuth secret -- generate dengan `npx auth secret`
AUTH_SECRET=""

# Midtrans -- service provider posture (revisi 2026-09-12): 1 akun
# platform buat SEMUA kolam (bukan per-pool lagi). Sandbox key pas
# develop lokal, production key pas deploy.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Midtrans Iris (disbursement/pencairan otomatis) -- OPSIONAL, produk
# terpisah dari Snap, butuh daftar & KYC bisnis sendiri di Midtrans.
# Kosongin dulu kalau belum daftar -- pencairan tetap jalan manual
# (admin transfer + tandai dibayar) lewat /admin/withdrawals.
MIDTRANS_IRIS_SERVER_KEY=""

# Web push -- generate dengan `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Base URL aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend -- inbox admin hello@swimprivatehub.biz.id (/admin/email). Domain
# biz.id sudah DKIM/SPF/MX verified di dashboard Resend. RESEND_API_KEY dari
# dashboard Resend; RESEND_WEBHOOK_SECRET dari halaman Webhooks pas bikin
# endpoint /api/webhooks/resend-inbound (event: email.received), formatnya
# "whsec_...".
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
