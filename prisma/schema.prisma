// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  MEMBER
  // Pemilik kolam -- akses cuma ke wallet & pengajuan pencairan kolamnya
  // SENDIRI (lihat requireRole/proxy.ts), gak ada akses admin lintas-kolam.
  // Ditambah pas fitur wallet (2026-09-12); sebelumnya owner yang
  // dimigrasi diturunin ke MEMBER (gak ada UI apapun buat mereka) --
  // sekarang butuh role sendiri karena mereka perlu liat saldo & cairin.
  POOL_OWNER
}

enum WalletTransactionType {
  // Kredit ke Pool TEMPAT SESI BENERAN DIAJAR (Booking.availability.poolId),
  // bukan pool tempat Package dibeli -- paket sekarang lintas-kolam
  // (revisi 2026-09-12), jadi kredit ditunda sampai tau pasti kolam mana
  // yang beneran ngasih fasilitas buat sesi itu. Dicatat bareng
  // SESSION_PAYOUT (coach), share bookingId yang sama.
  SESSION_REVENUE
  // Kredit ke Coach buat 1 sesi yang ditandai Hadir.
  SESSION_PAYOUT
  // Saldo keluar pas WithdrawalRequest berhasil diproses.
  WITHDRAWAL
  // Komisi platform per sesi Hadir, sudah dipisah dari PPN-nya (poolId &
  // coachProfileId kosong = milik platform). Lihat splitPlatformTax.
  PLATFORM_REVENUE
  PLATFORM_TAX
}

// Penarikan saldo platform oleh admin (transfer manual dari akun Midtrans).
// Saldo platform = total ledger PLATFORM_* dikurangi baris di sini.
model PlatformWithdrawal {
  id            String   @id @default(cuid())
  revenueAmount Int
  taxAmount     Int
  note          String?
  createdById   String
  createdAt     DateTime @default(now())
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PackageStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum CancelledBy {
  MEMBER
  ADMIN
  COACH
}

enum MarkedBy {
  COACH
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  phone              String?  @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  registeredReferer  String?
  registeredIp       String?

  coachProfile        CoachProfile?
  dependents          Dependent[]
  packages            Package[]
  bookings            Booking[]
  availabilities      Availability[]     @relation("CoachAvailabilities")
  pushSubscriptions   PushSubscription[]
  poolAffiliations    PoolAffiliation[]  @relation("CoachPoolAffiliations")
  poolOwnerships      PoolOwnership[]    @relation("PoolOwners")
  chatThread          ChatThread?
}

// Chat bantuan (tombol mengambang) buat member/coach/pemilik kolam. 1 user =
// 1 thread. Dijawab AI kalau GEMINI_API_KEY / ANTHROPIC_API_KEY ada; pertanyaan yang AI gak
// yakin (atau AI belum aktif) ditandai needsAdmin dan muncul di tab Pesan admin.
model ChatThread {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  needsAdmin Boolean       @default(false)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]

  @@index([needsAdmin, updatedAt])
}

enum ChatSender {
  USER
  AI
  ADMIN
  SYSTEM
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    ChatSender
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

enum Gender {
  MALE
  FEMALE
}

enum CertificateStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model CoachProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  isActive Boolean @default(true)
  // Poin-poin keahlian (misal "Gaya bebas", "Anak usia dini", "Terapi
  // air") -- array pendek, ditampilin di halaman shortcut coach
  // (/pelatih/[id]) & profil. Bukan free-text panjang, biar konsisten
  // scan-able buat parent yang milih coach.
  specialties       String[] @default([])
  // Badge "plus poin" kalau coach punya sertifikasi renang resmi
  // (misal sertifikasi pelatih renang/lifeguard). certificationNote
  // opsional -- nama sertifikat/lembaga, ditampilin di sebelah badge.
  hasCertification  Boolean  @default(false)
  certificationNote String?
  // Foto profil & file sertifikat (URL Supabase Storage). Badge
  // "Bersertifikat" cuma tampil kalau certificateStatus APPROVED oleh admin.
  photoUrl          String?
  certificateUrl    String?
  certificateStatus CertificateStatus @default(NONE)
  // Tanggal lahir & jenis kelamin coach -- orang tua sering memilih coach
  // berdasarkan dua hal ini. Umur dihitung dari birthDate (jangan simpan
  // umur sebagai angka: basi tiap tahun).
  birthDate         DateTime?
  gender            Gender?
  // Saldo coach ini dari bagian per-sesi (Pool.coachSharePercent),
  // dikredit pas booking ditandai Hadir. Lihat Pool.walletBalance buat
  // catatan yang sama soal cache-vs-ledger.
  walletBalance     Int      @default(0)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
}

// Ledger lengkap tiap pergerakan saldo -- walletBalance di Pool/CoachProfile
// itu CACHE (baca cepet), baris di sini yang jadi sumber kebenaran buat
// audit ("kenapa saldo gua segini"). Setiap update walletBalance WAJIB
// diiringi >=1 baris di sini dalam transaksi DB yang sama.
model WalletTransaction {
  id     String                @id @default(cuid())
  type   WalletTransactionType
  // Persis 1 dari dua ini yang keisi -- baris punya Pool ATAU CoachProfile,
  // gak pernah dua-duanya (dicek di action layer, bukan constraint DB,
  // pola yang sama kayak Pool.ownerUserId).
  poolId         String?
  pool           Pool?          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile?  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  // Positif = kredit (saldo nambah), negatif = debit (saldo berkurang).
  amount         Int
  // Referensi ke sumber transaksi -- paling banyak 1 yang keisi sesuai
  // type-nya (PACKAGE_SALE -> paymentId, SESSION_PAYOUT -> bookingId,
  // WITHDRAWAL -> withdrawalRequestId).
  paymentId          String?
  bookingId          String?
  withdrawalRequestId String?
  createdAt      DateTime              @default(now())

  @@index([poolId])
  @@index([coachProfileId])
}

// Pengajuan pencairan saldo (kolam ATAU coach, sama pola exactly-1
// kayak WalletTransaction). Phase 1: PENDING dibuat sistem otomatis
// begitu user klik "Cairkan"; transisi ke PROCESSING/PAID/FAILED butuh
// Midtrans Iris (disbursement) terpasang -- sebelum itu ada, admin yang
// proses manual dari /admin/withdrawals (lihat src/lib/disbursement.ts).
model WithdrawalRequest {
  id     String           @id @default(cuid())
  poolId String?
  pool   Pool?            @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  amount Int
  status WithdrawalStatus @default(PENDING)
  // Disalin dari Pool/CoachProfile pas request dibuat -- kalau rekening
  // tujuan diedit belakangan, request yang UDAH ADA gak boleh ikut
  // berubah diam-diam (riwayat pencairan harus nunjukin kemana duitnya
  // BENERAN dikirim saat itu).
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  midtransReferenceId String?
  failureReason       String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  @@index([poolId])
  @@index([coachProfileId])
}

// Profil anak nempel ke 1 akun ortu (User role MEMBER) -- 1 akun bisa
// punya banyak anak, tapi tetep 1 login/1 session buat semuanya. Bukan
// akun terpisah. isActive = soft delete: anak yang "dihapus" ortu cuma
// disembunyiin dari pilihan baru, riwayat Package/Booking lama tetap
// utuh (dibutuhin buat laporan honor coach).
model Dependent {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  // Peserta bisa akun itu sendiri (dewasa yang les sendiri), bukan cuma
  // anak -- isSelf nandain entry mana yang "diri sendiri" (nama-nya
  // dicopy dari User.name pas dibuat). Paling banyak 1 entry isSelf per
  // member, dicek di action layer (bukan constraint DB).
  isSelf    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  packages Package[]

  @@index([memberId])
}

// Katalog paket (harga/durasi) per KOLAM (locked /plan-eng-review
// 2026-09-12) -- tiap kolam pasang harga sendiri (kenyataan: kolam yang
// udah gabung sebelumnya emang udah punya harga masing-masing lewat
// Excel/WA, gak dipaksa 1 harga platform). poolId JUGA yang nentuin
// checkout Midtrans ini routing ke akun kolam mana (connector posture --
// platform gak pernah pegang dana, lihat Payment/Pool).
model PackageTemplate {
  id           String   @id @default(cuid())
  poolId       String
  pool         Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name         String
  totalSesi    Int
  price        Int
  // Masa berlaku paket dalam hari, dihitung dari startDate (aktivasi).
  durationDays Int      @default(60)
  // Jatah pembatalan mandiri (tanpa approval admin) yang dibawa tiap
  // paket yang dibuat dari template ini -- dicopy ke Package.jatahCancel
  // pas paket dibuat, BUKAN dibaca ulang dari template tiap kali cek
  // kuota (biar paket lama gak ikut berubah kalau template diedit).
  jatahCancel  Int      @default(2)
  isActive     Boolean  @default(true)
  // Usulan perubahan dari pemilik kolam yang menunggu persetujuan admin
  // (lihat src/lib/package-template.ts). Nilai di atas = yang sedang dijual.
  pendingChanges Json?
  createdAt    DateTime @default(now())

  packages Package[]

  @@index([poolId])
}

model Package {
  id          String           @id @default(cuid())
  memberId    String
  member      User             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Wajib -- 1 paket = 1 anak, gak pooled/gak bisa dipake gantian antar
  // anak. Ditulis sekali pas paket dibuat; kalau paket ini udah punya
  // >=1 Booking, dependentId GAK BOLEH diedit lagi (dicek di action
  // layer, bukan constraint DB) -- soalnya Booking gak nyimpen anak
  // sendiri, "anak"-nya booking diturunin dari sini. Edit dependentId
  // setelah ada booking = nge-rewrite riwayat anak booking lama diam-diam.
  dependentId String
  dependent   Dependent        @relation(fields: [dependentId], references: [id])
  // Kolam tempat beli, DAN satu-satunya kolam tempat paket ini bisa
  // dibooking (revisi 2026-09-17, gantiin paket lintas-kolam 2026-09-12:
  // beli di kolam murah lalu dipake di kolam mahal bikin kolam mahal
  // dibayar pake harga kolam murah). Mau renang di kolam lain = beli
  // paket 1 sesi di kolam itu (isSingleSession), lihat src/lib/drop-in.ts.
  poolId      String
  pool        Pool             @relation(fields: [poolId], references: [id])
  templateId  String?
  template    PackageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  totalSesi   Int
  sisaSesi    Int
  // Dicopy dari PackageTemplate.jatahCancel pas paket dibuat (atau
  // diisi manual kalau paket custom/assign langsung). Ini yang dipakai
  // buat cek kuota self-cancel, bukan konstanta global -- tiap paket
  // bisa punya jatah beda.
  jatahCancel Int              @default(2)
  // Paket eceran 1 sesi buat renang di kolam selain kolam paket utama.
  // Cuma bisa dibeli member yang masih punya paket biasa (bukan 1 sesi)
  // yang aktif -- dan paket 1 sesi sendiri gak ngitung sebagai syarat itu.
  isSingleSession Boolean      @default(false)
  status      PackageStatus    @default(PENDING_PAYMENT)
  startDate   DateTime?
  expiredDate DateTime?
  createdAt   DateTime         @default(now())

  payments Payment[]
  bookings Booking[]

  @@index([memberId])
  @@index([dependentId])
  @@index([poolId])
}

model Payment {
  id                String        @id @default(cuid())
  packageId         String
  package           Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  midtransOrderId   String        @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([packageId])
}

model Availability {
  id             String             @id @default(cuid())
  coachId        String
  coach          User               @relation("CoachAvailabilities", fields: [coachId], references: [id], onDelete: Cascade)
  // Kolam tempat slot ini dibuka. Coach independen dari Pool manapun
  // (PoolAffiliation), tapi tiap slot yang dibuka tetep pin ke SATU
  // kolam spesifik -- coach gak bisa "buka slot generik" tanpa kolam.
  poolId         String
  pool           Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  startTime      DateTime
  endTime        DateTime
  kapasitas      Int                @default(1)
  status         AvailabilityStatus @default(AVAILABLE)
  // Kosong buat MVP (availability per hari, input manual). Kolom ini
  // yang dipakai kalau fitur recurring/per-minggu ditambah belakangan,
  // biar gak perlu migrasi skema ulang.
  recurrenceRule String?
  createdAt      DateTime           @default(now())

  bookings Booking[]

  // SENGAJA gak ada poolId di constraint ini -- 1 coach cuma boleh
  // punya 1 slot terbuka per (date, startTime) di SELURUH kolam, titik.
  // Coach gak bisa ada di 2 tempat jam yang sama. Constraint dgn poolId
  // di dalamnya cuma nyegah duplikat slot yang SAMA di kolam yang SAMA,
  // gak nyegah coach ke-double-book lintas kolam -- itu bug yang
  // ketemu pas /plan-eng-review 2026-09-12.
  @@unique([coachId, date, startTime])
  @@index([poolId, date])
}

// Kolam/venue -- 1 pool = 1 lokasi fisik. SERVICE PROVIDER posture
// (revisi 2026-09-12, gantiin connector): platform pegang 1 akun
// Midtrans sendiri (QRIS), SEMUA transaksi dari SEMUA kolam masuk ke
// situ dulu -- makanya gak ada lagi kredensial Midtrans per-pool di
// sini (lihat src/lib/midtrans.ts, balik ke 1 akun global kayak
// les-renang-cianjur). Bagian kolam & coach disimpen di wallet
// (walletBalance) abis komisi platform kepotong, dicairkan manual
// lewat WithdrawalRequest.
model Pool {
  id                 String   @id @default(cuid())
  name               String
  address            String?
  contactPhone       String?
  // Jam operasional harian (format "HH:mm", misal "06:00"/"21:00").
  // Satu jam buka-tutup buat semua hari -- MVP, belum per-hari (Senin
  // beda jam sama Minggu dst). Ditampilin di profil kolam, BUKAN
  // constraint yang nge-block coach buka slot di luar jam ini (belum
  // divalidasi di action layer, murni informasional buat sekarang).
  openTime           String?
  closeTime          String?
  // Deskripsi & fasilitas kolam (warung, mushola, toilet, dst) -- diisi
  // pemilik kolam atau admin, tampil di landing, booking, halaman coach.
  description        String?
  facilities         String[] @default([])
  // Foto fasilitas kolam (URL publik Supabase Storage), diunggah pemilik
  // kolam/admin. Urutan array = urutan tampil; foto pertama jadi sampul.
  photos             String[] @default([])
  // Persentase komisi platform, di-set platform (bukan per-coach),
  // provisional 15% (lihat Open Questions di design doc). Config value,
  // bukan struktural -- boleh diubah tanpa migrasi.
  commissionPercent  Int      @default(15)
  // Persentase dari HARGA PAKET (bukan dari sisa abis komisi) yang jadi
  // bagian coach per sesi -- dikredit ke walletBalance coach BARENGAN
  // sama walletBalance kolam sendiri dikredit, pas booking ditandai
  // Hadir (lihat src/lib/wallet.ts). commissionPercent + coachSharePercent
  // harus <=100 (sisanya buat kolam), dicek di action layer pas admin edit.
  coachSharePercent  Int      @default(55)
  // Saldo kolam ini dari sesi-sesi yang BENERAN diajar di kolam ini
  // (dikredit pas Booking ditandai Hadir, bukan pas Package dibeli --
  // revisi 2026-09-12: paket lintas-kolam, kolam yang kredit itu kolam
  // TEMPAT SESI, bukan kolam tempat paket dibeli). Cache, lihat
  // WalletTransaction buat sumber kebenaran.
  walletBalance      Int      @default(0)
  // Tujuan pencairan (WithdrawalRequest). Nullable -- kolam yang belum
  // isi ini gak bisa ajuin cairin (dicek di action layer).
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  affiliations       PoolAffiliation[]
  availabilities     Availability[]
  packageTemplates   PackageTemplate[]
  packages           Package[]
  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  ownerships         PoolOwnership[]
}

// Many-to-many User(role=POOL_OWNER) <-> Pool -- gantiin Pool.ownerUserId
// (1 kolam = 1 owner doang) yang gak ngedukung 1 orang punya beberapa
// kolam sekaligus. Sama pola persis kayak PoolAffiliation (coach <-> pool),
// cuma beda arah relasi (owner, bukan orang yang ngajar).
model PoolOwnership {
  id        String   @id @default(cuid())
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation("PoolOwners", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([poolId, ownerId])
  @@index([ownerId])
}

// Many-to-many Coach <-> Pool. Coach (User role=COACH) tetep entity
// independen -- baris ini cuma nyatet "coach X bisa buka slot di kolam
// Y", bukan kepemilikan.
model PoolAffiliation {
  id        String   @id @default(cuid())
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachPoolAffiliations", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([poolId, coachId])
  @@index([coachId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id             String        @id @default(cuid())
  memberId       String
  member         User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  availabilityId String
  availability   Availability  @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  // "Anak" buat booking ini diturunin transitif lewat packageId ->
  // Package.dependentId -- sengaja gak nyimpen field anak sendiri di
  // sini, biar cuma ada 1 sumber kebenaran (bukan 2 field yang bisa
  // nyimpang). Relasi Package ditambah sekalian (sebelumnya packageId
  // cuma string lepas, gak ada FK constraint di DB sama sekali).
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  status         BookingStatus @default(BOOKED)
  cancelledBy    CancelledBy?
  cancelledAt    DateTime?
  // null = belum ditandai, true = member hadir (sesi valid buat coach),
  // false = member gak hadir (gak dihitung ke sesi valid coach walau
  // booking-nya tetep BOOKED dan sesi member tetep kepotong).
  attended       Boolean?
  attendedBy     MarkedBy?
  attendedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([memberId])
  @@index([availabilityId])
  @@index([packageId])
}

// Inbox email eksternal (hello@swimprivatehub.biz.id, via Resend Inbound) --
// beda dari ChatThread (itu chat bantuan in-app member/coach/pool <-> admin).
// 1 alamat email eksternal = 1 thread, sama kayak pola ChatThread per user.
model EmailThread {
  id            String         @id @default(cuid())
  externalEmail String         @unique
  subject       String
  needsAdmin    Boolean        @default(true)
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  messages      EmailMessage[]

  @@index([needsAdmin, updatedAt])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      EmailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction   EmailDirection
  fromAddress String
  toAddress   String
  subject     String
  textBody    String
  htmlBody    String?
  // id dari Resend (email_id pas INBOUND, id hasil send pas OUTBOUND) --
  // dipakai buat header In-Reply-To/References biar thread nyambung di
  // client email eksternal, dan cegah dobel-simpan webhook retry.
  resendId    String?        @unique
  createdAt   DateTime       @default(now())

  @@index([threadId, createdAt])
}
