# PostgreSQL connection string (Supabase). Untuk migrasi, pakai session
# pooler (port 5432) -- transaction pooler (port 6543) tidak support
# advisory lock yang dibutuhkan `prisma migrate`.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=no-verify"

# NextAuth secret -- generate dengan `npx auth secret`
AUTH_SECRET=""

# Midtrans -- connector posture: platform gak punya akun Midtrans sendiri,
# tiap kolam pake Server/Client Key MEREKA SENDIRI (disimpan terenkripsi
# di tabel Pool, lihat src/lib/pool-credentials.ts). Key di bawah ini
# CUMA buat enkripsi/dekripsi kredensial kolam di DB, bukan kredensial
# Midtrans platform itu sendiri.
# Generate dengan: openssl rand -base64 32
MIDTRANS_CREDENTIAL_ENCRYPTION_KEY=""

# Web push -- generate dengan `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Base URL aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
